# ╔══════════════════════════════════════════════════╗
# ║  Aegis Hotspot Vault — .gitignore                ║
# ║  CRITICAL: private keys & vault files NEVER push ║
# ╚══════════════════════════════════════════════════╝

# ── CRITICAL: Cryptographic Secrets ────────────────────────────
*.pem                   # RSA private & public keys — NEVER commit
*.vault                 # Encrypted vault files     — NEVER commit
*.key                   # Any raw key files

# ── Vault output directory ──────────────────────────────────────
shared_vault/           # Local vault store — excluded entirely

# ── Python ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
pip-log.txt
pip-delete-this-directory.txt

# ── Virtual environments ────────────────────────────────────────
venv/
.venv/
env/
.env/
ENV/

# ── Environment variables ───────────────────────────────────────
.env
.env.*
*.env

# ── OS junk ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE / Editor ────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Streamlit cache ─────────────────────────────────────────────
.streamlit/

# ── Logs ────────────────────────────────────────────────────────
*.log
logs/

# ── Temporary files ─────────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
